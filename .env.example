# TIKLIVE_API_KEY: Required for connecting to TikLive API (https://api.tiklive.eu/dashboard).
# Stored strictly on the server — never exposed to the browser frontend.
TIKLIVE_API_KEY="YOUR_TIKLIVE_API_KEY"

# TIKLIVE_API_BASE: Base URL for TikLive Public LIVE API.
TIKLIVE_API_BASE="https://api.tiklive.eu"

# APP_URL: The URL where this platform is hosted (used to build shareable OBS Overlay URLs).
APP_URL="http://localhost:3000"
